#!/bin/sh
# claude-review — переходник codex-диалекта review-kit на claude CLI.
#
# Зачем: review-kit (scripts/review/local.sh, завендорен в 24 репо) зовёт
# ревьюера строкой `$review_cmd --sandbox read-only --output-schema <s>
# --output-last-message <v> - < prompt.txt` — диалект codex exec. REVIEW_CMD —
# задуманная точка подмены (кит собирает команду word-splitting'ом), но флаги
# вокруг неё codex-специфичны, поэтому нужна не другая строка, а программа,
# которая говорит на codex-диалекте снаружи и на claude-диалекте внутри.
# Так переключение ревьюера работает во всех репо с китом сразу, без единого
# ре-вендорного PR (devtools#121).
#
# Живёт в scripts/harness/, НЕ в scripts/review/: последняя целиком пинована
# PIN-ом кита (sha256 шести файлов), чужой файл рядом ломал бы дисциплину
# ре-вендоринга. Судьба файла: удалить, когда steward канонизирует
# харнесс-слой в самом ките (inbox-issue туда; тег в TODO devtools).
#
# Контракт выхода — как у codex exec для кита: не-0 → кит печатает
# «ревьюер не отработал» и выходит кодом 3; пустой вердикт кит ловит сам.
# Молчаливый approve при сломанном ревьюере невозможен по построению.
#
# Литерал протокола `codex-terminal-review` в маркерах ревью НЕ
# переименовывается: это имя протокола, не имя бинаря — по нему парсятся уже
# опубликованные вердикты (fp-наследование, --use-verdict). Переименование —
# только при канонизации у steward, с миграцией парсеров.
#
# Read-only не «на слово CLI»: --restricted снимает Bash/REPL/WebFetch и
# игнорирует пользовательские settings, --tools оставляет ровно чтение
# (Read/Glob/Grep), --permission-prompts none автоматически отказывает всему
# остальному, --strict-mcp-config отрезает MCP оператора,
# --no-session-persistence не сорит сессиями в целевом репо.
set -eu

fail() {
    _code="$1"; shift
    echo "claude-review: $*" >&2
    exit "$_code"
}

model="claude-opus-5"
sandbox=""
schema=""
verdict=""
stdin_marker=0
while [ $# -gt 0 ]; do
    case "$1" in
        --model)
            [ $# -ge 2 ] || fail 2 "--model требует значение"
            model="$2"; shift 2 ;;
        --sandbox)
            [ $# -ge 2 ] || fail 2 "--sandbox требует значение"
            sandbox="$2"; shift 2 ;;
        --output-schema)
            [ $# -ge 2 ] || fail 2 "--output-schema требует путь"
            schema="$2"; shift 2 ;;
        --output-last-message)
            [ $# -ge 2 ] || fail 2 "--output-last-message требует путь"
            verdict="$2"; shift 2 ;;
        -) stdin_marker=1; shift ;;
        # Неизвестный флаг — отказ, не молчаливое игнорирование: кит нового
        # поколения мог добавить семантику, которую переходник не понимает,
        # и «продолжить как понял» дало бы ревью не на тех условиях.
        *) fail 2 "неизвестный аргумент: $1" ;;
    esac
done
[ "$sandbox" = "read-only" ] \
    || fail 2 "поддержан только --sandbox read-only (получено: '${sandbox:-}')"
[ -n "$schema" ] || fail 2 "--output-schema обязателен"
[ -r "$schema" ] || fail 2 "схема нечитаема: $schema"
[ -n "$verdict" ] || fail 2 "--output-last-message обязателен"
[ "$stdin_marker" -eq 1 ] || fail 2 "ожидается '-' (промпт со stdin)"

# Промпт идёт со stdin (как и у codex) — диф не попадает в argv.
# stderr claude проходит насквозь в reviewer.err кита.
set +e
out=$(claude -p --model "$model" \
    --json-schema "$(cat "$schema")" \
    --output-format json \
    --restricted --strict-mcp-config --no-session-persistence \
    --permission-prompts none \
    --tools Read Glob Grep)
claude_code=$?
set -e
[ "$claude_code" -eq 0 ] || fail 3 "claude завершился кодом $claude_code"

# Разбор конверта: только успешный ответ с непустым structured_output
# становится вердиктом; всё остальное — не-0 (кит превратит в свой код 3).
# Вердикт пишется атомарно (tmp + rename): полузаписанный JSON не должен
# сойти за вердикт при гибели между write и exit.
printf '%s' "$out" | python3 -c '
import json
import sys

try:
    envelope = json.load(sys.stdin)
except (ValueError, UnicodeDecodeError):
    sys.exit(3)
if not isinstance(envelope, dict):
    sys.exit(3)
if envelope.get("is_error") or envelope.get("subtype") != "success":
    sys.exit(3)
structured = envelope.get("structured_output")
if not structured:
    sys.exit(3)
import os
tmp = sys.argv[1] + ".tmp"
with open(tmp, "w", encoding="utf-8") as handle:
    json.dump(structured, handle, ensure_ascii=False)
os.replace(tmp, sys.argv[1])
' "$verdict" || fail 3 "ответ claude без валидного structured_output"
